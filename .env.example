POSTGRES_PASSWORD=replace-with-a-long-random-value
MINIO_ROOT_USER=replace-with-a-nondefault-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value
OPENWEATHER_API_KEY=
# The polling client posts normalized observations to this FastAPI route.
INGESTION_API_URL=http://127.0.0.1:8000/events

# Host ports only; container-to-container MinIO remains minio:9000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
